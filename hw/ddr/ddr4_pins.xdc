set_property PACKAGE_PIN M19 [get_ports {ddr4_rtl_0_adr[5]}]
set_property PACKAGE_PIN H16 [get_ports {ddr4_rtl_0_adr[4]}]
set_property PACKAGE_PIN G18 [get_ports {ddr4_rtl_0_adr[3]}]
set_property PACKAGE_PIN R18 [get_ports {ddr4_rtl_0_adr[2]}]
set_property PACKAGE_PIN H17 [get_ports {ddr4_rtl_0_adr[1]}]
set_property PACKAGE_PIN N16 [get_ports {ddr4_rtl_0_adr[0]}]

# ---- data mask (9) ----
