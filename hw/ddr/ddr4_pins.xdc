# 250-SoC PL DDR4 pinout (DDR4_2400_250SP, 72-bit = 64 data + 8 ECC, x16 components).
# For the DDR4 (MIG) IP: interface name ddr4_rtl_0, system clock diff_clock_rtl_1 (J19).
# NOTE: diff_clock_rtl_0 (AH10) and reset_rtl_0 (AM16) here are the HOST PCIe ref clock / reset and already
# exist in fpga-nvme-driver.xdc as host_ref_clk_p[0] / host_rstn -- do NOT duplicate; only the ddr4_rtl_0_*
# pins and diff_clock_rtl_1 below are added for the DDR4 controller.

# ---- DDR4 system clock ----
set_property PACKAGE_PIN J19 [get_ports diff_clock_rtl_1_clk_p]

# ---- address (17) ----
set_property PACKAGE_PIN J17 [get_ports {ddr4_rtl_0_adr[16]}]
set_property PACKAGE_PIN M16 [get_ports {ddr4_rtl_0_adr[15]}]
set_property PACKAGE_PIN K18 [get_ports {ddr4_rtl_0_adr[14]}]
set_property PACKAGE_PIN P20 [get_ports {ddr4_rtl_0_adr[13]}]
set_property PACKAGE_PIN G19 [get_ports {ddr4_rtl_0_adr[12]}]
set_property PACKAGE_PIN R20 [get_ports {ddr4_rtl_0_adr[11]}]
set_property PACKAGE_PIN G16 [get_ports {ddr4_rtl_0_adr[10]}]
set_property PACKAGE_PIN N17 [get_ports {ddr4_rtl_0_adr[9]}]
set_property PACKAGE_PIN P19 [get_ports {ddr4_rtl_0_adr[8]}]
set_property PACKAGE_PIN N20 [get_ports {ddr4_rtl_0_adr[7]}]
